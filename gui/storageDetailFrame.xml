<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI name="RmStorageDetailFrame">

    <!-- ================================================================= -->
    <!-- LEFT PANEL: Storage Selection Sidebar                             -->
    <!-- ================================================================= -->

    <ThreePartBitmap profile="fs25_subCategoryContainerBg">
        <Bitmap profile="fs25_subCategoryContainerArrow"/>
    </ThreePartBitmap>
    <Bitmap profile="fs25_subCategoryContainer">
        <MultiTextOption profile="fs25_subCategorySelector" id="categorySelector" onClick="onCategoryChanged"/>
        <BoxLayout profile="fs25_subCategorySelectorBox" id="categoryDotBox"/>
        <RoundCorner profile="fs25_subCategorySelectorDot" id="categoryDotTemplate"/>

        <GuiElement profile="fs25_subCategoryListContainer">
            <Bitmap profile="fs25_subCategoryStartClipper" name="startClipper"/>
            <Bitmap profile="fs25_subCategoryStopClipper" name="endClipper"/>
            <SmoothList profile="fs25_subCategoryList" id="storageList"
                        startClipperElementName="startClipper"
                        endClipperElementName="endClipper"
                        focusChangeRight="detailList">
                <ListItem profile="fs25_subCategoryListItem">
                    <Bitmap profile="fs25_subCategoryListItemIcon" name="storageIcon"/>
                    <Text profile="fs25_subCategoryListItemName" name="storageName"/>
                    <Text profile="fs25_subCategoryListItemName" name="storageInfo" position="100px -52px" textBold="false" textSize="14px" textUpperCase="false"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_subCategoryListSliderBox" id="storageSliderBox">
                <Slider profile="fs25_listSlider" dataElementId="storageList" id="storageSlider"/>
            </ThreePartBitmap>
        </GuiElement>
    </Bitmap>

    <!-- Left empty state -->
    <Text profile="rmFreshStorageEmptyText" id="emptyState" text="$l10n_fresh_storage_detail_empty" visible="false"/>

    <!-- ================================================================= -->
    <!-- RIGHT PANEL: Header + Detail View                                 -->
    <!-- ================================================================= -->

    <GuiElement profile="fs25_menuContentContainer" id="contentContainer">

        <!-- Page header -->
        <GuiElement profile="fs25_menuHeaderPanel" position="0px 74px">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="fresh.icon_storage"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_fresh_storage_detail_title"/>
        </GuiElement>

        <!-- Detail title (selected storage name) -->
        <Text profile="rmFreshDetailTitle" id="detailTitle" visible="false"/>

        <!-- Detail total amount -->
        <Text profile="rmFreshDetailTotal" id="detailTotal" visible="false"/>

        <!-- Table header row 1: column labels -->
        <Bitmap profile="rmFreshTableList" id="detailTableHeader" position="20px -80px" size="1160px 30px" visible="false" with="anchorTopLeft">
            <Text profile="rmFreshTableHeaderLeftAligned" position="10px 0px" size="260px 30px" text="$l10n_fresh_detail_column_name"/>
            <Text profile="rmFreshTableHeaderLeftAligned" position="270px 0px" size="110px 30px" name="classColumnHeader" text="$l10n_fresh_column_storage"/>
            <Text profile="rmFreshDetailHeaderFresh" position="380px 0px" size="160px 30px" text="$l10n_fresh_bucket_fresh"/>
            <Text profile="rmFreshDetailHeaderGood" position="540px 0px" size="160px 30px" text="$l10n_fresh_bucket_good"/>
            <Text profile="rmFreshDetailHeaderWarning" position="700px 0px" size="160px 30px" text="$l10n_fresh_bucket_warning"/>
            <Text profile="rmFreshDetailHeaderCritical" position="860px 0px" size="160px 30px" text="$l10n_fresh_bucket_critical"/>
            <Text profile="rmFreshTableHeaderRightAligned" position="1020px 0px" size="130px 30px" text="$l10n_fresh_column_timeleft"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </Bitmap>

        <!-- Table header row 2: percentage sub-labels -->
        <Bitmap profile="rmFreshTableList" id="detailSubHeader" position="20px -110px" size="1160px 20px" visible="false" with="anchorTopLeft">
            <Text profile="rmFreshDetailSubheader" position="380px 0px" size="160px 20px" text="$l10n_fresh_bucket_fresh_pct"/>
            <Text profile="rmFreshDetailSubheader" position="540px 0px" size="160px 20px" text="$l10n_fresh_bucket_good_pct"/>
            <Text profile="rmFreshDetailSubheader" position="700px 0px" size="160px 20px" text="$l10n_fresh_bucket_warning_pct"/>
            <Text profile="rmFreshDetailSubheader" position="860px 0px" size="160px 20px" text="$l10n_fresh_bucket_critical_pct"/>
        </Bitmap>

        <!-- Detail fillType list -->
        <SmoothList profile="rmFreshTableList" id="detailList" position="20px -135px" size="1160px 590px"
                    visible="false" with="anchorTopLeft" focusChangeLeft="storageList">
            <ListItem profile="rmFreshTableListItem" size="1160px 48px">
                <Bitmap profile="rmFreshFillTypeIcon" position="10px -9px" size="30px 30px" name="fillTypeIcon"/>
                <Text profile="rmFreshTableRowCellLeftAligned" position="44px 0px" size="216px 48px" name="fillTypeName" textLayoutMode="scrolling"/>
                <Text profile="rmFreshTableRowCellLeftAligned" position="270px 0px" size="110px 48px" name="classLabel"/>
                <Text profile="rmFreshTableRowCellRightAligned" position="380px 0px" size="160px 48px" name="freshAmount"/>
                <Text profile="rmFreshTableRowCellRightAligned" position="540px 0px" size="160px 48px" name="goodAmount"/>
                <Text profile="rmFreshTableRowCellRightAligned" position="700px 0px" size="160px 48px" name="warningAmount"/>
                <Text profile="rmFreshTableRowCellRightAligned" position="860px 0px" size="160px 48px" name="criticalAmount"/>
                <Text profile="rmFreshTableRowCellRightAligned" position="1020px 0px" size="130px 48px" name="expiresIn"/>
            </ListItem>
        </SmoothList>

        <!-- Detail empty state -->
        <Text profile="rmFreshStorageEmptyText" id="detailEmptyState" text="$l10n_fresh_storage_detail_no_selection" visible="true"/>

    </GuiElement>

    <!-- Shared profiles (rmFreshDetailTotal, rmFreshDetailTitle, rmFreshDetailSubheader)
         are defined in guiProfiles.xml -->
    <GUIProfiles>
        <Profile name="rmFreshStorageEmptyText" extends="fs25_textDefault" with="anchorMiddleCenter">
            <textSize value="24px"/>
            <textAlignment value="center"/>
            <textAutoWidth value="true"/>
            <textMaxNumLines value="3"/>
            <textMaxWidth value="500px"/>
        </Profile>
    </GUIProfiles>

</GUI>
