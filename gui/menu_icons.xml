<?xml version="1.0" encoding="utf-8"?>
<!-- Fresh mod icon sprite sheet (1024x1024, 128x128 grid)
     Source SVGs: Lucide icons (stroke=1), see icons/lucide/originals/
     Registered with prefix "fresh" via g_overlayManager -->
<texture>
    <meta>
        <filename>menu_icons.png</filename>
        <size width="1024" height="1024"/>
    </meta>
    <slices>
        <!-- Row 0 -->
        <slice id="icon_overview"  uvs="0px 0px 128px 128px"/>
        <slice id="icon_product"   uvs="128px 0px 128px 128px"/>
        <slice id="icon_storage"   uvs="256px 0px 128px 128px"/>
        <slice id="icon_stats"     uvs="384px 0px 128px 128px"/>
        <!-- Row 1 -->
        <slice id="icon_shelflife" uvs="0px 128px 128px 128px"/>
        <slice id="icon_settings"  uvs="128px 128px 128px 128px"/>
    </slices>
</texture>
