<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI name="RmSettingsFrame">
    <GuiElement profile="fs25_menuContainer">
        <!-- Header -->
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="fresh.icon_settings"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_fresh_settings_title"/>
        </GuiElement>

        <!-- Sub-category tab bar -->
        <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="subCategoryBox">
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[1]"
                    text="$l10n_fresh_tab_settings" onClick="onClickSettingsTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[2]"
                    text="$l10n_fresh_tab_expiration" onClick="onClickExpirationTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[3]"
                    text="$l10n_fresh_tab_maxbenefit" onClick="onClickMaxBenefitTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[4]"
                    text="$l10n_fresh_tab_storage" onClick="onClickStorageTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
        </BoxLayout>
        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px"/>
        <MultiTextOption profile="fs25_subCategorySelectorTabbed" id="subCategoryPaging"
                         position="0px -10px" onClick="updateSubCategoryPages"/>

        <!-- Page 1: Global Settings -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subCategoryPages[1]">
            <ScrollingLayout profile="fs25_settingsLayout" id="sc1Layout">
                <Text profile="fs25_settingsSectionHeader" text="$l10n_fresh_settings_global"/>

                <!-- Enable Expiration toggle (master switch) -->
                <Bitmap profile="fs25_multiTextOptionContainer" onCreate="onCreateSettingRow">
                    <BinaryOption profile="fs25_settingsBinaryOption" id="checkEnableExpiration"
                        onClick="onClickEnableExpiration">
                        <Text profile="fs25_multiTextOptionTooltip" name="ignore"
                            text="$l10n_fresh_settings_enableExpiration_tooltip"/>
                    </BinaryOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle"
                        text="$l10n_fresh_settings_enableExpiration"/>
                </Bitmap>

                <!-- Preset selector -->
                <Bitmap profile="fs25_multiTextOptionContainer" onCreate="onCreateSettingRow">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="presetSelector"
                        onClick="onClickPreset">
                        <Text profile="fs25_multiTextOptionTooltip" name="ignore"
                            text="$l10n_fresh_settings_preset_tooltip"/>
                    </MultiTextOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_fresh_settings_preset"/>
                </Bitmap>

                <!-- Storage Aging toggle -->
                <Bitmap profile="fs25_multiTextOptionContainer" onCreate="onCreateSettingRow">
                    <BinaryOption profile="fs25_settingsBinaryOption" id="checkStorageAging"
                        onClick="onClickStorageAging">
                        <Text profile="fs25_multiTextOptionTooltip" name="ignore"
                            text="$l10n_fresh_settings_storageAging_tooltip"/>
                    </BinaryOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle"
                        text="$l10n_fresh_settings_storageAging"/>
                </Bitmap>

                <!-- Show Warnings toggle -->
                <Bitmap profile="fs25_multiTextOptionContainer" onCreate="onCreateSettingRow">
                    <BinaryOption profile="fs25_settingsBinaryOption" id="checkShowWarnings"
                        onClick="onClickShowWarnings">
                        <Text profile="fs25_multiTextOptionTooltip" name="ignore"
                            text="$l10n_fresh_settings_showWarnings_tooltip"/>
                    </BinaryOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle"
                        text="$l10n_fresh_settings_showWarnings"/>
                </Bitmap>

                <!-- Warning Threshold selector -->
                <Bitmap profile="fs25_multiTextOptionContainer" onCreate="onCreateSettingRow">
                    <MultiTextOption profile="fs25_settingsMultiTextOption" id="warningHoursSelector"
                        onClick="onClickWarningHours">
                        <Text profile="fs25_multiTextOptionTooltip" name="ignore"
                            text="$l10n_fresh_settings_warningHours_tooltip"/>
                    </MultiTextOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle"
                        text="$l10n_fresh_settings_warningHours"/>
                </Bitmap>

                <!-- Show Age Display toggle -->
                <Bitmap profile="fs25_multiTextOptionContainer" onCreate="onCreateSettingRow">
                    <BinaryOption profile="fs25_settingsBinaryOption" id="checkShowAgeDisplay"
                        onClick="onClickShowAgeDisplay">
                        <Text profile="fs25_multiTextOptionTooltip" name="ignore"
                            text="$l10n_fresh_settings_showAgeDisplay_tooltip"/>
                    </BinaryOption>
                    <Text profile="fs25_settingsMultiTextOptionTitle"
                        text="$l10n_fresh_settings_showAgeDisplay"/>
                </Bitmap>

            </ScrollingLayout>
        </GuiElement>

        <!-- Page 2: Expiration - all perishable fill types (cloned at runtime) -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subCategoryPages[2]">
            <ScrollingLayout profile="fs25_settingsLayout" id="sc2Layout">
                <Text profile="fs25_settingsSectionHeader" text="$l10n_fresh_settings_fillTypes"/>
                <Text profile="rmFreshSettingsInfoText" id="sc2NoRowsMsg"
                    text="$l10n_fresh_settings_presetActive" visible="false"/>

                <!-- Template: cloned per fillType, then unlinked -->
                <Bitmap profile="fs25_multiTextOptionContainer" id="sc2RowTemplate" onCreate="onCreateSettingRow">
                    <MultiTextOption profile="fs25_settingsMultiTextOption">
                        <Text profile="fs25_multiTextOptionTooltip" name="fillTypeTooltip"/>
                    </MultiTextOption>
                    <Bitmap profile="rmFreshFillTypeIcon" position="10px -7px" size="30px 30px"
                        name="fillTypeIcon"/>
                    <Text profile="fs25_settingsMultiTextOptionTitle" position="50px 0px"
                        text="Template Label"/>
                </Bitmap>
            </ScrollingLayout>
        </GuiElement>

        <!-- Page 3: Max Benefit - per-fillType class ceiling (cloned at runtime) -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subCategoryPages[3]">
            <ScrollingLayout profile="fs25_settingsLayout" id="sc3Layout">
                <Text profile="fs25_settingsSectionHeader" text="$l10n_fresh_settings_maxBenefitHeader"/>

                <!-- Template: cloned per fillType, then unlinked -->
                <Bitmap profile="fs25_multiTextOptionContainer" id="sc3RowTemplate" onCreate="onCreateSettingRow">
                    <MultiTextOption profile="fs25_settingsMultiTextOption">
                        <Text profile="fs25_multiTextOptionTooltip" name="maxBenefitTooltip"/>
                    </MultiTextOption>
                    <Bitmap profile="rmFreshFillTypeIcon" position="10px -7px" size="30px 30px"
                        name="fillTypeIcon"/>
                    <Text profile="rmFreshDetectedClassLabel" position="360px 0px"
                        text="Default: Indoor"/>
                    <Text profile="fs25_settingsMultiTextOptionTitle" position="50px 0px"
                        text="Template Label"/>
                </Bitmap>
            </ScrollingLayout>
        </GuiElement>

        <!-- Page 4: Storage - per-building/vehicle class overrides (cloned at runtime) -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subCategoryPages[4]">
            <ScrollingLayout profile="fs25_settingsLayout" id="sc4Layout">
                <Text profile="fs25_settingsSectionHeader" text="$l10n_fresh_settings_storageHeader"/>

                <!-- Template: cloned per storage entity, then unlinked -->
                <Bitmap profile="rmFreshStorageRowContainer" id="sc4RowTemplate" onCreate="onCreateSettingRow">
                    <MultiTextOption profile="fs25_settingsMultiTextOption">
                        <Text profile="fs25_multiTextOptionTooltip" name="storageTooltip"/>
                    </MultiTextOption>
                    <Bitmap profile="rmFreshFillTypeIcon" position="3px -3px" size="70px 70px"
                        name="entityIcon"/>
                    <Text profile="fs25_settingsMultiTextOptionTitle" position="80px 0px"
                        text="Building Name"/>
                    <Text profile="rmFreshStorageDetectedLabel" position="360px 0px"
                        text="Detected: Indoor"/>
                </Bitmap>
            </ScrollingLayout>
        </GuiElement>
    </GuiElement>

    <!-- Slider for all pages (rebinds to active layout on tab switch) -->
    <ThreePartBitmap profile="fs25_sliderDockedBg">
        <ThreePartBitmap profile="fs25_sliderDockedBox">
            <Slider profile="fs25_sliderDocked" id="settingsSlider" dataElementId="sc1Layout"/>
        </ThreePartBitmap>
    </ThreePartBitmap>
</GUI>
