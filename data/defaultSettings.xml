        <fillType name="SQUAREBALE_DRYGRASS" expires="false" hidden="true"/>
        <fillType name="SQUAREBALE_GRASS" expires="false" hidden="true"/>
        <fillType name="SQUAREBALE_WOOD" expires="false" hidden="true"/>

        <!-- ===================================================================== -->
        <!-- NON-EXPIRING: Wood & construction (hidden - not relevant to freshness)-->
        <!-- ===================================================================== -->
        <fillType name="BOARDS" expires="false" hidden="true"/>
        <fillType name="PLANKS" expires="false" hidden="true"/>
