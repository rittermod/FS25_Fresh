        <!-- ===================================================================== -->
        <!-- NON-EXPIRING: Manufactured goods (hidden - not relevant to freshness) -->
        <!-- ===================================================================== -->
        <fillType name="BARREL" expires="false" hidden="true"/>
        <fillType name="BATHTUB" expires="false" hidden="true"/>
        <fillType name="BUCKET" expires="false" hidden="true"/>
        <fillType name="CARTONROLL" expires="false" hidden="true"/>
        <fillType name="CLOTHES" expires="false" hidden="true"/>
        <fillType name="FABRIC" expires="false" hidden="true"/>
